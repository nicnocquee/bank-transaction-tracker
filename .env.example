# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://tracker:tracker@localhost:5432/bank_transaction_tracker?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# AES-256 key for IMAP passwords (64 hex chars = 32 bytes)
# Generate with: openssl rand -hex 32
IMAP_SECRET_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# App URL (Auth.js)
AUTH_URL="http://localhost:3000"

# Set to 1 only for local e2e / demos (injects sample receipt without IMAP)
ALLOW_FIXTURE_SYNC="0"
NEXT_PUBLIC_ALLOW_FIXTURE_SYNC="0"

# Server cron (Bearer token for POST/GET /api/cron/sync)
CRON_SECRET="replace-with-a-long-random-cron-secret"

# node-cron schedule for `npm run cron:worker` (default: every 5 minutes)
CRON_SCHEDULE="*/5 * * * *"
